# Catalyst function dependencies — reinstalled by the CLI on deploy
node_modules/

# OS noise
.DS_Store

# Agent tooling — vendored gstack skills, symlinked to an absolute local path.
# Not portable, and it leaks the machine's home directory.
.claude/
.gstack/

# Catalyst CLI local state — project/env IDs, machine-specific
.catalystrc
catalyst-debug.log

# Secrets
.env
.env.*
!.env.example

# `catalyst serve` injects this dev-only live-reload script into the Slate dir.
# slate-config.toml in the same folder IS tracked, so ignore just this file.
onam-quiz/.catalyst/reload-script.js
